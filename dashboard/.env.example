# Salin ke .env.local (mode biasa) atau .env.live.local (npm run dev:live).
#
# live = data asli dari server EduPad (default)
# mock = preview data contoh, hanya jika dipilih secara eksplisit
VITE_DATA_SOURCE=live

# Dipakai bila VITE_DATA_SOURCE=live
# Kosongkan saat memakai proxy Vite lokal ke Office API port 8001.
VITE_API_URL=

# Interval refresh otomatis (detik)
VITE_REFRESH_SECONDS=30
