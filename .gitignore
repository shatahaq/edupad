# Python
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
.test-tmp/

# Secrets: API keys, the server SSH key, campus session cookies and browser profiles.
# Copy them to the server with scp (see deploy/SERVER.md), never through git.
.env
*.pem
user_data/

# Runtime data: course materials, corpus, schedules, assignments, voice clips, tutor bank,
# device status and Office state. Created by the pipeline and the server; personal or
# third-party content, so it is never committed.
/data/

# Logs
logs/

# Web apps: dependencies and build output are recreated with `npm ci && npm run build`
apps/*/node_modules/
apps/*/dist/
apps/*/.vite/

# Firmware screen preview (built with `make` in firmware/preview)
firmware/preview/build/
firmware/preview/out/

# Local tooling
.claude/
.mcp.json
.codebase-memory/
.playwright-mcp/
