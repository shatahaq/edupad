# Server untuk perangkat ESP32 (STT -> agent -> TTS).
# Pasang:  sudo cp deploy/edupad-server.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now edupad-server
# Log:     journalctl -u edupad-server -f   (juga logs/serve.log)
[Unit]
Description=EduPad server untuk perangkat ESP32
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/Tugas_Akhir
ExecStart=/home/ubuntu/Tugas_Akhir/.venv/bin/python -m edupad serve --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
