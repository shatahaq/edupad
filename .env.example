# Notifikasi Telegram (opsional). Token dari @BotFather, chat id dari @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cadangan penyaring kelas bila jadwal (KRS) belum diambil, mis. B.
EDUPAD_CLASS=

# ID mata kuliah yang tugasnya diabaikan, dipisah koma.
EDUPAD_IGNORED_COURSES=

# LLM agent: DeepSeek (platform.deepseek.com).
API_KEY_AI=

# Vector database: Supabase -> Project Settings -> API Keys -> Secret key (sb_secret_...).
SUPABASE_SECRET_KEY=

# Embedding bge-m3: Cloudflare dashboard -> AI -> Workers AI -> Use REST API.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Token perangkat ESP32 untuk `python -m edupad serve` (wajib bila server bisa diakses dari jaringan).
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"  lalu salin ke firmware.
EDUPAD_DEVICE_TOKEN=

# Pengenalan suara (STT): Groq Whisper (console.groq.com -> API Keys).
API_KEY_GROQ=
# EDUPAD_STT_MODEL=whisper-large-v3-turbo   # whisper-large-v3 sedikit lebih akurat, ~3x lebih mahal

# Suara (TTS): ElevenLabs -> profil -> API Keys (izin Text to Speech, Voices read, User read).
# Voice ID dari Voices -> My Voices -> Copy voice ID. Akun gratis: hanya suara bawaan / buatan sendiri.
API_KEY_ElevenLabs=
Voice_ID_ElevenLabs=
# EDUPAD_TTS_MODEL=eleven_multilingual_v2   # eleven_flash_v2_5 lebih cepat & lebih hemat kuota

# Web EduPad + Google Classroom (lihat deploy/SERVER.md, bagian "Login Google & Classroom").
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Alamat web yang dibuka di browser. Daftarkan <EDUPAD_PUBLIC_URL>/auth/google/callback sebagai
# "Authorized redirect URI". Pengembangan: http://localhost:5173 (npm run dev). Produksi: wajib
# domain HTTPS (Google menolak alamat IP), mis. https://edupad.domainkamu.id
EDUPAD_PUBLIC_URL=http://localhost:5173
# Email Google pemilik server, dipisah koma: Classroom-nya dibaca agent di perangkat/CLI.
# Akun Google lain tetap bisa login, datanya terpisah.
EDUPAD_OWNER_EMAILS=
